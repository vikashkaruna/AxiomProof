{
  "name": "@axiom/bff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "echo 'no lint config'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "echo 'BFF has no Playwright suite; see apps/web/tests/e2e'",
    "clean": "rm -rf dist .turbo coverage"
  },
  "dependencies": {
    "@axiom/approval-engine": "workspace:*",
    "@axiom/config": "workspace:*",
    "@axiom/control-library": "workspace:*",
    "@axiom/evidence": "workspace:*",
    "@axiom/ledger": "workspace:*",
    "@axiom/supabase": "workspace:*",
    "@axiom/types": "workspace:*",
    "@hono/node-server": "^1.13.1",
    "@supabase/supabase-js": "^2.45.4",
    "hono": "^4.5.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
