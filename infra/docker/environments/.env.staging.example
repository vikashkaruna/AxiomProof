# Axiom Proof — Staging Environment (.env.staging)
ENVIRONMENT=staging
NODE_ENV=staging
LOG_LEVEL=info

# Service Ports
MARKETING_PORT=3000
WEB_PORT=3001
BFF_PORT=4000
AGENT_RUNTIME_PORT=8000
MODEL_GATEWAY_PORT=8001
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233

# Supabase Staging
SUPABASE_URL=https://staging.supabase.axiomminds.ai
SUPABASE_ANON_KEY=staging-anon-key-placeholder
SUPABASE_SERVICE_KEY=staging-service-key-placeholder
SUPABASE_DB_URL=postgresql://postgres:staging_password@staging-db.internal:5432/postgres

# Next.js Public
NEXT_PUBLIC_SUPABASE_URL=https://staging.supabase.axiomminds.ai
NEXT_PUBLIC_SUPABASE_ANON_KEY=staging-anon-key-placeholder
NEXT_PUBLIC_BFF_URL=https://staging-api.axiomminds.ai
NEXT_PUBLIC_APP_URL=https://staging-app.axiomminds.ai
NEXT_PUBLIC_MARKETING_URL=https://staging.axiomminds.ai

# Inter-service URLs
AGENT_RUNTIME_URL=http://agent-runtime.staging.svc.cluster.local:8000
MODEL_GATEWAY_URL=http://model-gateway.staging.svc.cluster.local:8001
BFF_URL=http://bff.staging.svc.cluster.local:4000
TEMPORAL_ADDRESS=staging-temporal.internal:7233
TEMPORAL_NAMESPACE=axiom-proof-staging
TEMPORAL_TLS=true
TEMPORAL_API_KEY=staging-temporal-key

# Security
APPROVAL_SIGNING_KEY=staging-signing-secret-key-at-least-32-chars-long
AGENT_RUNTIME_INTERNAL_TOKEN=staging-agent-runtime-internal-token
MODEL_GATEWAY_API_KEY=staging-model-gateway-api-key
BFF_CORS_ORIGINS=https://staging.axiomminds.ai,https://staging-app.axiomminds.ai

# AWS ap-south-1
AWS_REGION=ap-south-1
AWS_S3_EVIDENCE_BUCKET=axiom-proof-evidence-staging
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Feature Flags
FEATURE_DRY_RUN_ENGINE=true
FEATURE_EXECUTION_ENGINE=true
FEATURE_LIVE_CONNECTORS=true
FEATURE_KILL_SWITCH=true
