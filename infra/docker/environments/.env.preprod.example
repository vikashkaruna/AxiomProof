# Axiom Proof — Preprod Environment (.env.preprod)
ENVIRONMENT=staging
NODE_ENV=production
LOG_LEVEL=info

# Service Ports
MARKETING_PORT=3000
WEB_PORT=3001
BFF_PORT=4000
AGENT_RUNTIME_PORT=8000
MODEL_GATEWAY_PORT=8001
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233

# Supabase Preprod
SUPABASE_URL=https://preprod.supabase.axiomminds.ai
SUPABASE_ANON_KEY=preprod-anon-key-placeholder
SUPABASE_SERVICE_KEY=preprod-service-key-placeholder
SUPABASE_DB_URL=postgresql://postgres:preprod_password@preprod-db.internal:5432/postgres

# Next.js Public
NEXT_PUBLIC_SUPABASE_URL=https://preprod.supabase.axiomminds.ai
NEXT_PUBLIC_SUPABASE_ANON_KEY=preprod-anon-key-placeholder
NEXT_PUBLIC_BFF_URL=https://preprod-api.axiomminds.ai
NEXT_PUBLIC_APP_URL=https://preprod-app.axiomminds.ai
NEXT_PUBLIC_MARKETING_URL=https://preprod.axiomminds.ai

# Inter-service URLs
AGENT_RUNTIME_URL=http://agent-runtime.preprod.svc.cluster.local:8000
MODEL_GATEWAY_URL=http://model-gateway.preprod.svc.cluster.local:8001
BFF_URL=http://bff.preprod.svc.cluster.local:4000
TEMPORAL_ADDRESS=preprod-temporal.internal:7233
TEMPORAL_NAMESPACE=axiom-proof-preprod
TEMPORAL_TLS=true
TEMPORAL_API_KEY=preprod-temporal-key

# Security
APPROVAL_SIGNING_KEY=preprod-signing-secret-key-at-least-32-chars-long
AGENT_RUNTIME_INTERNAL_TOKEN=preprod-agent-runtime-internal-token
MODEL_GATEWAY_API_KEY=preprod-model-gateway-api-key
BFF_CORS_ORIGINS=https://preprod.axiomminds.ai,https://preprod-app.axiomminds.ai

# AWS ap-south-1
AWS_REGION=ap-south-1
AWS_S3_EVIDENCE_BUCKET=axiom-proof-evidence-preprod
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Feature Flags
FEATURE_DRY_RUN_ENGINE=true
FEATURE_EXECUTION_ENGINE=true
FEATURE_LIVE_CONNECTORS=true
FEATURE_KILL_SWITCH=true
