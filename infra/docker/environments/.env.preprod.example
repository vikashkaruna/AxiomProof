# ==============================================================================
# Axiom Proof — GCP Preprod Environment Configuration (.env.preprod)
# Region: Mumbai (asia-south1) · Sovereign Indian Data Residency
# ==============================================================================
ENVIRONMENT=preprod
NODE_ENV=production
LOG_LEVEL=info

# ─── Service Ports (Cloud Run automatically binds to $PORT) ───────────────────
MARKETING_PORT=3000
WEB_PORT=3001
BFF_PORT=4000
AGENT_RUNTIME_PORT=8000
MODEL_GATEWAY_PORT=8001
PORT=8080

# ─── Google Cloud Platform (Mumbai asia-south1) ──────────────────────────────
GCP_PROJECT_ID=axiom-proof
GCP_REGION=asia-south1
AWS_REGION=asia-south1

# ─── Cloud SQL for PostgreSQL (asia-south1) ──────────────────────────────────
# In Cloud Run: Unix domain socket /cloudsql/<PROJECT_ID>:<REGION>:<INSTANCE_NAME>
# In local/direct preprod: IP connection
SUPABASE_DB_URL=postgresql://axiom_admin:preprod_db_password_here@<CLOUD_SQL_IP>:5432/axiom_proof_preprod
SUPABASE_URL=https://preprod-supabase.axiomminds.ai
SUPABASE_ANON_KEY=preprod-anon-key-placeholder
SUPABASE_SERVICE_KEY=preprod-service-key-placeholder

# ─── Upstash Serverless Redis ────────────────────────────────────────────────
UPSTASH_REDIS_URL=rediss://default:YOUR_UPSTASH_TOKEN@your-preprod-redis.upstash.io:6379
REDIS_URL=rediss://default:YOUR_UPSTASH_TOKEN@your-preprod-redis.upstash.io:6379

# ─── Temporal Cloud GCP Subscription ─────────────────────────────────────────
TEMPORAL_ADDRESS=axiom-proof.tmprl.cloud:7233
TEMPORAL_NAMESPACE=axiom-proof
TEMPORAL_TLS=true
TEMPORAL_API_KEY=your-temporal-cloud-gcp-api-key

# ─── Multi-Model Fallback Chain (Anthropic -> OpenAI -> Gemini) ───────────────
# 1. Primary: Anthropic Claude (claude-3-5-sonnet-20241022)
ANTHROPIC_API_KEY=sk-ant-api03-...
# 2. Fallback 1: OpenAI (gpt-4o / gpt-4o-mini)
OPENAI_API_KEY=sk-proj-...
# 3. Fallback 2: Google Gemini (gemini-2.0-flash / gemini-1.5-pro)
GEMINI_API_KEY=AIzaSy...
GOOGLE_API_KEY=AIzaSy...

# ─── Evidence Vault (Google Cloud Storage in asia-south1 with WORM Lock) ──────
AWS_S3_EVIDENCE_BUCKET=axiom-proof-evidence-preprod
AWS_S3_ENDPOINT=https://storage.googleapis.com
AWS_ACCESS_KEY_ID=GOOG1E... # GCS HMAC Access ID
AWS_SECRET_ACCESS_KEY=...    # GCS HMAC Secret Key

# ─── Cloud Run Service URLs ──────────────────────────────────────────────────
BFF_URL=https://axiom-bff-preprod-xyz.a.run.app
NEXT_PUBLIC_BFF_URL=https://axiom-bff-preprod-xyz.a.run.app
NEXT_PUBLIC_APP_URL=https://axiom-web-preprod-xyz.a.run.app
NEXT_PUBLIC_MARKETING_URL=https://axiom-proof.web.app
AGENT_RUNTIME_URL=https://axiom-agent-runtime-preprod-xyz.a.run.app
MODEL_GATEWAY_URL=https://axiom-model-gateway-preprod-xyz.a.run.app

# ─── Sovereign Security & Signing Keys ────────────────────────────────────────
APPROVAL_SIGNING_KEY=preprod-hmac-sha256-signing-secret-key-minimum-32-chars
AGENT_RUNTIME_INTERNAL_TOKEN=preprod-internal-agent-runtime-secret-token
MODEL_GATEWAY_API_KEY=preprod-internal-model-gateway-secret-token
BFF_CORS_ORIGINS=https://axiom-proof.web.app,https://axiom-web-preprod-xyz.a.run.app,http://localhost:3000,http://localhost:3001

# ─── Statutory Feature Flags ─────────────────────────────────────────────────
FEATURE_DRY_RUN_ENGINE=true
FEATURE_EXECUTION_ENGINE=true
FEATURE_LIVE_CONNECTORS=true
FEATURE_KILL_SWITCH=true
PII_REDACTION_ENABLED=true
